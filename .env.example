# ── Groq (Primary LLM Provider) ──────────────────────────────────────────────
# Get free key at: https://console.groq.com  (14,400 req/day free)
GROQ_API_KEY=your_groq_api_key_here

# ── Gemini (Fallback LLM Provider) ───────────────────────────────────────────
# Get free key at: https://aistudio.google.com/apikey  (1,500 req/day free)
# Key format must start with "AIzaSy..."
GEMINI_API_KEY=your_gemini_api_key_here

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=resume_screener
